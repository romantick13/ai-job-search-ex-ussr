<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AiJobSearchBy.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="620" d:DesignHeight="560"
        x:Class="AiJobSearchBy.Views.ApplicationDetailsWindow"
        Title="Отправленный отклик — ai-job-search-by"
        Width="640" Height="620" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#0A1A14"
        FontFamily="Segoe UI, Noto Sans, sans-serif">

  <!-- WP-U1 (требование владельца): модальное окно истории — «при клике
       открывается вариант резюме, которое отправил». Метаданные + текст
       отправленного резюме + кнопки: PDF с диска, вакансия в браузере.
       Стиль — Emerald Crystal. -->
  <Window.Resources>
    <SolidColorBrush x:Key="GlassBrush" Color="#E61A2E26"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#50FFB0"/>
    <SolidColorBrush x:Key="DimBrush" Color="#8FB8A8"/>
    <SolidColorBrush x:Key="CardEdge" Color="#243D34"/>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Border.glass">
      <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BoxShadow" Value="5 5 15 0 #050C0A, -5 -5 15 0 #243D34"/>
    </Style>
    <Style Selector="TextBlock.panel-title">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,10">
      <Button Grid.Column="1" x:Name="OpenVacancyButton" Content="Открыть вакансию"
              FontSize="11.5" Padding="10,4"/>
      <Button Grid.Column="2" x:Name="OpenPdfButton" Content="Открыть PDF"
              FontSize="11.5" Padding="10,4" Margin="8,0,0,0"/>
      <Button Grid.Column="3" x:Name="CloseButton" Content="Закрыть"
              FontSize="11.5" Padding="10,4" Margin="8,0,0,0"/>
    </Grid>

    <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="0,10,0,0">
      <TextBlock x:Name="PdfPathText" Classes="hint" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="VectorText" Classes="hint"/>
      <TextBlock Classes="hint"
                 Text="Векторная ссылка (локальная модель Qwen3-Embedding) позволяет всегда вернуться к отправленному варианту — файлы PDF остаются на диске в папке откликов."/>
    </StackPanel>

    <Border Classes="glass" Padding="14">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock x:Name="EmployerText" FontSize="17" FontWeight="Bold"/>
          <TextBlock x:Name="SentText" FontSize="14"
                     Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="TitleText" FontSize="12.5" Classes="hint"/>
        <TextBlock x:Name="UrlText" FontSize="11" TextWrapping="Wrap"
                   Foreground="{StaticResource AccentBrush}"/>
        <TextBlock Text="Вариант резюме, который был отправлен" Classes="panel-title" Margin="0,4,0,0"/>
        <Border BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="8">
          <TextBox x:Name="ResumeTextBox"
                   IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                   FontSize="12" Background="Transparent" BorderThickness="0"
                   MinHeight="260" MaxHeight="420"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Border>
      </StackPanel>
    </Border>

  </DockPanel>

</Window>
