<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AiJobSearchBy.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="560" d:DesignHeight="420"
        x:Class="AiJobSearchBy.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Настройки — ai-job-search-by"
        Width="560" MinWidth="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#0A1A14"
        FontFamily="Segoe UI, Noto Sans, sans-serif">

 <!-- отдельное МОДАЛЬНОЕ окно настроек ( шестерёнка
 сверху справа -> настройки). Ключи пишутся в local.json атомарно
 (ConfigService.UpdateAiKey, маска в протоколе); применяются после
 перезапуска приложения — честная плашка внизу. Стиль — Emerald Crystal. -->
  <Window.Resources>
    <SolidColorBrush x:Key="GlassBrush" Color="#E61A2E26"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#50FFB0"/>
    <SolidColorBrush x:Key="DimBrush" Color="#8FB8A8"/>
    <SolidColorBrush x:Key="CardEdge" Color="#243D34"/>
  </Window.Resources>

  <Window.Styles>
 <!-- обычный текст окна — белый (требование);
 hint/panel-title ниже переопределяют этот стиль -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Border.glass">
      <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BoxShadow" Value="5 5 15 0 #050C0A, -5 -5 15 0 #243D34"/>
    </Style>
    <Style Selector="TextBlock.panel-title">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Styles>

  <StackPanel Margin="16" Spacing="10">

    <StackPanel Spacing="2">
 <!-- заголовок окна — едко-зелёный, как в главном окне -->
      <TextBlock Text="Настройки" FontSize="18" FontWeight="Bold"
                 Foreground="{StaticResource AccentBrush}"/>
      <TextBlock Classes="hint"
                 Text="Ключи лежат в local.json — файл вне репо (%APPDATA%\ai-job-search-by\), в git не попадает. Вступают в силу после перезапуска приложения."/>
    </StackPanel>

    <Border Classes="glass" Padding="14">
      <StackPanel Spacing="10">
        <TextBlock Text="Ключи провайдеров" Classes="panel-title"/>
 <!-- звеньев может стать много («Добавить провайдера»/«Добавить
 модель») — секция листается, окно остаётся прежнего размера -->
        <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,4,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingsRow">
                <StackPanel Spacing="3" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                               IsVisible="{Binding !IsCustom}"/>
                    <TextBlock Text="{Binding CustomName}" FontSize="13" FontWeight="SemiBold"
                               IsVisible="{Binding IsCustom}"/>
                    <Button Grid.Column="1" Content="удалить"
                            IsVisible="{Binding IsCustom}"
                            Command="{Binding $parent[ItemsControl].DataContext.RemoveRowCommand}"
                            CommandParameter="{Binding}"
                            FontSize="10.5" Padding="6,1"/>
                  </Grid>
                  <TextBox Text="{Binding CustomName}" PlaceholderText="имя провайдера (например, OpenRouter)"
                           FontSize="12" IsVisible="{Binding IsCustom}"/>
                  <TextBox Text="{Binding BaseUrl}" PlaceholderText="адрес OpenAI-совместимого API (…/v1/)"
                           FontFamily="Consolas, 'DejaVu Sans Mono', monospace" FontSize="11.5"
                           IsVisible="{Binding IsCustom}"/>
                  <TextBox Text="{Binding CustomModel}" PlaceholderText="модель (id из каталога провайдера)"
                           FontFamily="Consolas, 'DejaVu Sans Mono', monospace" FontSize="11.5"
                           IsVisible="{Binding IsCustom}"/>
                  <TextBox Text="{Binding ApiKey}" PlaceholderText="API-ключ"
                           FontFamily="Consolas, 'DejaVu Sans Mono', monospace" FontSize="11.5"/>
                  <TextBlock Classes="hint" Text="{Binding Hint}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding AddProviderCommand}" Content="Добавить провайдера" FontSize="12"/>
          <Button Command="{Binding AddModelCommand}" Content="Добавить модель" FontSize="12"/>
        </StackPanel>
        <TextBlock Classes="hint"
                   Text="Кастомные звенья сохраняются в local.json (Chain.Custom) и появляются карточками на главном экране сразу; в рабочую цепь адаптации входят после перезапуска. VPN/прокси для заблокированных провайдеров — на вашей совести."/>
      </StackPanel>
    </Border>

    <Border Classes="glass" Padding="14">
      <StackPanel Spacing="6">
        <TextBlock Text="Папка откликов (PDF)" Classes="panel-title"/>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding OutboxPath}" FontSize="11.5"
                   PlaceholderText="Документы\ai-job-search-by"/>
          <Button Grid.Column="1" x:Name="PickFolderButton"
                  Content="Выбрать…" Margin="8,0,0,0" FontSize="11.5"/>
        </Grid>
        <TextBlock Classes="hint"
                   Text="Сюда складываются PDF отправленных резюме (имя: работодатель_дата-время). Первый запуск проиндексирует содержимое — извлечённый текст попадает в базу (r21: без векторов, векторизация вырезана)."/>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,Auto,Auto">
      <Button Grid.Column="1" Command="{Binding DoneCommand}" Content="Отмена" FontSize="12"/>
      <Button Grid.Column="2" Command="{Binding SaveCommand}" Content="Сохранить" FontWeight="SemiBold"
              Margin="8,0,0,0"/>
    </Grid>

  </StackPanel>

</Window>
