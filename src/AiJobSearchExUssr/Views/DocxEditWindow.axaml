<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="560" d:DesignHeight="600"
        x:Class="AiJobSearchExUssr.Views.DocxEditWindow"
        Title="Правка DOCX — ai-job-search-ex-ussr"
        Width="580" Height="620" MinWidth="500" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#0A1A14"
        FontFamily="Segoe UI, Noto Sans, sans-serif">

 <!-- Решение (план редактора, шаги 1-2): точечная
 правка DOCX нативно + правка текста отправленного резюме с пересборкой
 нашего PDF — «одно-два слова/запятая», без внешних редакторов.
 Форматирование файла не трогается: правятся только текстовые ноды.
 Стиль — Emerald Crystal (тот же, что у окна деталей отклика). -->
  <Window.Resources>
    <SolidColorBrush x:Key="GlassBrush" Color="#E61A2E26"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#50FFB0"/>
    <SolidColorBrush x:Key="DimBrush" Color="#8FB8A8"/>
    <SolidColorBrush x:Key="CardEdge" Color="#243D34"/>
  </Window.Resources>

  <Window.Styles>
 <!-- обычный текст окна — белый (требование);
 hint/panel-title ниже переопределяют этот стиль -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Border.glass">
      <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BoxShadow" Value="5 5 15 0 #050C0A, -5 -5 15 0 #243D34"/>
    </Style>
    <Style Selector="TextBlock.panel-title">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      <Button x:Name="PickButton" Content="Выбрать DOCX…"
              FontSize="11.5" Padding="10,4"/>
      <TextBlock Grid.Column="2" x:Name="DocxPathText" Classes="hint"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </Grid>

    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
 <!-- подпись переехала в самый низ окошка -->
      <TextBlock x:Name="FootHint" Classes="hint"
                 Text="Правится только текст — шрифты, стили и вёрстка файла остаются как были. Правка сохраняется в тот же файл (атомарно)."/>
      <TextBlock x:Name="StatusText" Classes="hint" TextWrapping="Wrap"/>
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <Button Grid.Column="1" x:Name="CloseButton" Content="Закрыть"
                FontSize="11.5" Padding="10,4"/>
        <Button Grid.Column="2" x:Name="SaveResumeButton" Content="Сохранить и пересобрать PDF"
                FontSize="11.5" Padding="10,4" Margin="8,0,0,0"
                IsVisible="False" IsEnabled="False"/>
        <Button Grid.Column="3" x:Name="ReplaceButton" Content="Заменить и сохранить"
                FontSize="11.5" Padding="10,4" Margin="8,0,0,0" IsEnabled="False"/>
      </Grid>
    </StackPanel>

 <!-- Фикс ( превью распирает и съедает низ —
 кнопки «Заменить и сохранить» обрезаны, подписи не видно): середина —
 Grid со звёздной строкой превью (тянется вместе с окном, скролл внутри),
 подпись о правке — в самый низ окошка, в блок с кнопками (Dock=Bottom) —
 низ всегда на месте при любом размере окна. -->
    <Border Classes="glass" Padding="14">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="Найти (точный текст)" Classes="panel-title"/>
        <TextBox Grid.Row="1" x:Name="FindBox" PlaceholderText="напр., «Senior C#» или лишнюю запятую"
                 Margin="0,6,0,0"/>
        <TextBlock Grid.Row="2" Text="Заменить на (пусто = удалить)" Classes="panel-title" Margin="0,8,0,0"/>
        <TextBox Grid.Row="3" x:Name="ReplaceBox" Margin="0,6,0,0"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
          <CheckBox x:Name="MatchCaseBox" Content="Учитывать регистр" FontSize="11.5"/>
          <TextBlock x:Name="MatchesText" Classes="hint" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Row="5" x:Name="PreviewTitle" Text="Текст документа" Classes="panel-title" Margin="0,10,0,6"/>
        <Border Grid.Row="6" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="8">
          <TextBox x:Name="PreviewBox"
                   IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                   FontSize="12" Background="Transparent" BorderThickness="0"
                   MinHeight="110"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Border>
      </Grid>
    </Border>

  </DockPanel>

</Window>
