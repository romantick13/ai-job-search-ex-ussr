<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="560" d:DesignHeight="620"
        x:Class="AiJobSearchExUssr.Views.PdfOverlayWindow"
        Title="Заплатка PDF — ai-job-search-ex-ussr"
        Width="580" Height="640" MinWidth="500" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#0A1A14"
        FontFamily="Segoe UI, Noto Sans, sans-serif">

 <!-- Решение (план редактора, шаг 3): точечная заплатка
 чужого PDF — белый прямоугольник поверх слова + штамп замены.
 Координаты слов даёт PdfPig, рисование поверх — PdfSharpCore (MIT).
 Стиль — Emerald Crystal (тот же, что у окна правки DOCX). -->
  <Window.Resources>
    <SolidColorBrush x:Key="GlassBrush" Color="#E61A2E26"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#50FFB0"/>
    <SolidColorBrush x:Key="DimBrush" Color="#8FB8A8"/>
    <SolidColorBrush x:Key="CardEdge" Color="#243D34"/>
  </Window.Resources>

  <Window.Styles>
 <!-- обычный текст окна — белый (требование);
 hint/panel-title ниже переопределяют этот стиль -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Border.glass">
      <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BoxShadow" Value="5 5 15 0 #050C0A, -5 -5 15 0 #243D34"/>
    </Style>
    <Style Selector="TextBlock.panel-title">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      <Button x:Name="PickButton" Content="Выбрать PDF…"
              FontSize="11.5" Padding="10,4"/>
      <TextBlock Grid.Column="2" x:Name="PdfPathText" Classes="hint"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </Grid>

    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
      <TextBlock x:Name="StatusText" Classes="hint" TextWrapping="Wrap"/>
      <Grid ColumnDefinitions="*,Auto,Auto">
        <Button Grid.Column="1" x:Name="CloseButton" Content="Закрыть"
                FontSize="11.5" Padding="10,4"/>
        <Button Grid.Column="2" x:Name="OverlayButton" Content="Залатать"
                FontSize="11.5" Padding="10,4" Margin="8,0,0,0" IsEnabled="False"/>
      </Grid>
    </StackPanel>

    <Border Classes="glass" Padding="14">
      <StackPanel Spacing="8">
        <TextBlock Text="Найти (слово или его часть)" Classes="panel-title"/>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="FindBox" PlaceholderText="напр., «Ромашка» внутри слова «Ромашка,»"/>
          <Button Grid.Column="1" x:Name="SearchButton" Content="Найти"
                  FontSize="11.5" Padding="10,4" Margin="8,0,0,0" IsEnabled="False"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="14">
          <CheckBox x:Name="MatchCaseBox" Content="Учитывать регистр" FontSize="11.5"/>
          <TextBlock x:Name="MatchesText" Classes="hint" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="Заменить на (пусто = закрасить)" Classes="panel-title"/>
        <TextBox x:Name="ReplaceBox"/>
        <TextBlock Text="Найдено в файле" Classes="panel-title" Margin="0,4,0,0"/>
        <Border BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="8">
          <ListBox x:Name="HitsList"
                   Background="Transparent" BorderThickness="0"
                   MaxHeight="150" MinHeight="60">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" FontSize="11.5"
                           Foreground="{StaticResource DimBrush}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
        <TextBlock x:Name="FootHint" Classes="hint"
                   Text="Заплатка закрывает слово целиком (токен с пунктуацией) и впечатывает замену. Текстовый слой сохраняет старое слово под плашкой — поиск по базе найдёт и старое, и новое. Файл сохраняется атомарно, в тот же путь."/>
      </StackPanel>
    </Border>

  </DockPanel>

</Window>
